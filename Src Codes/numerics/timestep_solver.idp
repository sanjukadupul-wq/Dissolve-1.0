// numerics/timestep_solver.idp
// Solves each governing equation for the current time step: level set,
// redistancing, Zn/Cl/film/O2/OH transport, and (optionally) fluid flow.

IFMACRO(!idpTimestepSolver)
macro idpTimestepSolver 1//

if (enableLevelSet)
{
  if (mpirank==0) { print("Solving level-set equation..."); setCPUTime }

  Loc = shrink(SpaceP1, SpaceP1);
  B = shrink(0, SpaceP1);
  A = Loc;
  phi[] = A^-1 * B;

  if (mpirank==0) { printElapsedTime }
}

if (enableRedistancing)
{
  if (t >= nextRedistanceTime)
  {
    if (mpirank == 0)
      print("Redistancing the distance function...")

    // Volume BEFORE reinitialization -- direct check (2026-08-14) of
    // whether distance()/restrict() is volume-preserving, per the huge
    // with/without redistancing mass-loss discrepancy found today.
    real volBeforeLoc = intN(MeshNoOverlap)((phi > 0));
    real volBeforeGlob = 0;
    mpiAllReduce(volBeforeLoc, volBeforeGlob, mpiCommWorld, mpiSUM);

    fespace SpaceBackup(MeshBackup, Pk);
    SpaceBackup phiG, phiReduce;

    phiTemp = phi;
    phiTemp[] .*= A.D;

    int[int] rst = restrict(SpaceP1, SpaceBackup, newToOldGlobal);

    phiG = 0;
    for[i, v : rst] phiG[][v] = phiTemp[][i];

    phiReduce = 0;
    mpiAllReduce(phiG[], phiReduce[], mpiCommWorld, mpiSUM);

    // Stage V1: after restrict() + the sum-reduce onto MeshBackup, BEFORE
    // distance() runs. MeshBackup is a fully-replicated (non-partitioned)
    // mesh -- every rank now holds the complete summed field, so this is
    // already a global volume, no further mpiAllReduce needed.
    real V1 = intN(MeshBackup)((phiReduce > 0));

    distance(MeshBackup, phiReduce, phiG[]);

    // Stage V2: after distance(), still on MeshBackup, BEFORE projecting
    // back onto the original mesh/space.
    real V2 = intN(MeshBackup)((phiG > 0));

    // Volume correction (2026-09-02, hardened iterative version):
    // distance() is not exactly volume-preserving -- confirmed real (not a
    // measurement artifact) by cross-checking dV_distance against actual
    // result.txt jumps: disc ~0.003-0.03%/call, gyroid's higher-curvature
    // surface ~0.5%/call, both small per call but compounding over hundreds
    // of calls in a 12-month run.
    //
    // The single-shot linear correction (epsilon = dV/surfaceArea, tried
    // 2026-08-31) assumes shifting phi by a constant epsilon moves the
    // zero-level-set by ~epsilon along its normal EVERYWHERE -- a first-
    // order approximation that only holds when epsilon is small relative
    // to local curvature. It is exact enough for smooth TPMS surfaces
    // (gyroid, schwarz-P: 0% correction failure at every porosity tested,
    // 2026-09-02 cross-topology sweep) but overshoots badly at strut/node
    // lattice junctions (FCC, BCC), where local curvature is sharp -- FCC
    // p70 retained only 22.6% of its true cumulative mass loss at the raw
    // final timestep, BCC p70 only 58.7%. A medial-axis thickness check
    // (2026-09-02) ruled out under-resolution as the cause: FCC/BCC p70
    // struts are 0.24-0.36mm median thickness, comfortably above the
    // 2*epsilon=0.15mm interface width, with only 0.1-0.4% of the
    // structure genuinely thin -- concentrated at the sharp junctions.
    // Gyroid p70 by contrast has thinner ridge features (20.8% below the
    // same threshold) yet zero artifact, confirming curvature -- not
    // thickness -- is what breaks the single linear shift.
    //
    // Fix: damped Newton fixed-point iteration, surface area recomputed
    // every step (so the local linearization is redone at the current
    // interface, not the pre-correction one), with a bracket-bisection
    // fallback if Newton ever proposes a step that would leave a known
    // sign-change bracket, and hard caps on both the per-step and the
    // cumulative interface displacement so a bad case can never silently
    // run away. (An earlier iterated/fixed-point version without these
    // safety rails was validated 2026-08-31 -- job 59612283 -- reducing
    // gyroid's residual another ~30-160x over the single-shot version;
    // this block supersedes it.)
    real Vtarget = volBeforeGlob;
    real omega = 0.5;                  // relaxation factor
    int  maxCorrSteps = 15;
    real relTol = 1e-6;
    real maxShiftPerStep = 0.20 * h;   // within the 0.10-0.25*h_local band
    real maxTotalShift   = 3.0 * h;    // hard cap on cumulative displacement

    real deltaTotal = 0.0;
    real Vcur = V2;
    real relResid = (abs(Vtarget) > 1e-12) ? abs(Vtarget - Vcur) / abs(Vtarget) : 0.0;

    real bracketLo = 0.0, bracketHi = 0.0;
    real residLo = 0.0, residHi = 0.0;
    bool haveBracket = false;
    bool capped = false;
    bool converged = (relResid < relTol);
    int corrStep = 0;

    while (!converged && corrStep < maxCorrSteps && !capped)
    {
      real Acur = int2d(MeshBackup, levelset=phiG)(1.0);
      real resid = Vtarget - Vcur;

      real step = (Acur > 1e-9) ? (omega * resid / Acur) : 0.0;
      if (step >  maxShiftPerStep) step =  maxShiftPerStep;
      if (step < -maxShiftPerStep) step = -maxShiftPerStep;

      real deltaTrial = deltaTotal + step;

      // Newton step would leave the known bracket -> bisect instead
      if (haveBracket && ((deltaTrial < bracketLo) || (deltaTrial > bracketHi)))
        deltaTrial = 0.5 * (bracketLo + bracketHi);

      if (deltaTrial >  maxTotalShift) { deltaTrial =  maxTotalShift; capped = true; }
      if (deltaTrial < -maxTotalShift) { deltaTrial = -maxTotalShift; capped = true; }

      phiG[] += (deltaTrial - deltaTotal);
      deltaTotal = deltaTrial;
      Vcur = intN(MeshBackup)((phiG > 0));
      real residNew = Vtarget - Vcur;

      // a sign change between the previous and new residual brackets the
      // root; once bracketed, keep narrowing it regardless of what Newton
      // proposes next
      if (!haveBracket && (resid * residNew < 0.0))
      {
        bracketLo = min(deltaTotal - step, deltaTotal);
        bracketHi = max(deltaTotal - step, deltaTotal);
        residLo = resid; residHi = residNew;
        haveBracket = true;
      }
      else if (haveBracket)
      {
        if ((residLo > 0) == (residNew > 0))
          { bracketLo = deltaTotal; residLo = residNew; }
        else
          { bracketHi = deltaTotal; residHi = residNew; }
      }

      relResid = (abs(Vtarget) > 1e-12) ? abs(residNew) / abs(Vtarget) : 0.0;
      converged = (relResid < relTol);
      corrStep = corrStep + 1;
    }

    real V2corrected = Vcur;
    real volCorrection = deltaTotal;   // cumulative shift, kept for the debug print below

    if (mpirank == 0 && (!converged || capped))
      cout << "WARNING_REDIST_CORRECTION_NOT_CONVERGED t=" << t
           << " steps=" << corrStep << " relResid=" << relResid
           << " deltaTotal=" << deltaTotal << " capped=" << capped << endl;

    phiReduce = phiG;

    // Return trip: EXACT index-based gather, not interpolation.
    // `phi = phiReduce` (what this used to be) is a cross-mesh
    // INTERPOLATION between the partitioned Mesh and the global,
    // pre-partition MeshBackup -- per-stage volume instrumentation
    // (2026-08-14) showed it eating 80-90% of every redistancing call's
    // volume loss (2-6% of the whole scaffold, per call, hundreds of
    // calls per run), while the forward trip above was volume-exact
    // because it uses the `rst` index map.
    //
    // The mirrored form below is the canonical FreeFEM prolongation --
    // see examples/hpddm/restriction-2d-PETSc.edp, which spells out both
    // directions over ONE restrict() array:
    //     g[]           = u[](restCond);   // restrict  (big -> small)
    //     u[](restCond) = uCond[];         // prolong   (small -> big)
    // Forward here is the scatter `phiG[][v] = phiTemp[][i]`, so the exact
    // inverse is the gather `phi[][i] = phiG[][v]` over the same `rst`.
    // Pure index gather: no interpolation, exact by construction.
    for[i, v : rst] phi[][i] = phiReduce[][v];

    nextRedistanceTime += redistanceInterval;

    // Apples-to-apples check: measure the post-gather volume with the SAME
    // expression V0 used (direct `(phi>0)` quadrature on MeshNoOverlap),
    // not via the SpaceP0-projected `scaffold`. V0/V1/V2 all use direct
    // indicator evaluation; `glob` below uses the P0 projection -- kept
    // ONLY as a diagnostic to show the gap, it is NOT real lost volume
    // (confirmed 2026-08-30 by cross-checking against actual result.txt
    // jumps, which use direct quadrature via write_results.idp and never
    // went through `scaffold` at all) and must never be used to judge
    // whether a run's mass-loss curve is trustworthy -- read dV_distance
    // (now corrected to ~0, see the volCorrection block above) instead.
    real volAfterDirectLoc = intN(MeshNoOverlap)((phi > 0));
    real volAfterDirectGlob = 0;
    mpiAllReduce(volAfterDirectLoc, volAfterDirectGlob, mpiCommWorld, mpiSUM);

    scaffold = (phi > 0);
    loc = intN(MeshNoOverlap)(scaffold);
    glob = 0;
    mpiAllReduce(loc, glob, mpiCommWorld, mpiSUM);

    if (mpirank == 0) {
      cout << "DEBUG_REDIST_STAGES t=" << t
           << " V0=" << volBeforeGlob << " V1=" << V1 << " V2=" << V2
           << " V2corrected=" << V2corrected << " volCorrection=" << volCorrection
           << " corrSteps=" << corrStep << " corrConverged=" << converged
           << " corrCapped=" << capped << " corrRelResid=" << relResid
           << " V3=" << glob << " V3direct=" << volAfterDirectGlob
           << " dV_restrict=" << (V1 - volBeforeGlob)
           << " dV_distance=" << (V2 - V1)
           << " dV_distance_corrected=" << (V2corrected - V1)
           << " dV_projectback_DIRECT=" << (volAfterDirectGlob - V2corrected)
           << " dV_P0projection_DIAGNOSTIC_ONLY=" << (glob - volAfterDirectGlob)
           << endl;
      // Real per-call loss: direct quadrature, post volume-correction --
      // matches what result.txt actually reports (write_results.idp uses
      // the same direct-quadrature form). NOT `glob`/P0-projected -- see
      // the note above.
      real dV = volAfterDirectGlob - volBeforeGlob;
      real dVpct = (volBeforeGlob > 1e-12) ? (dV / volBeforeGlob * 100.0) : 0.0;
      cout << "DEBUG_REDIST t=" << t << " V_before=" << volBeforeGlob
           << " V_after=" << volAfterDirectGlob << " dV=" << dV << " dV_pct=" << dVpct << endl;
    }

  }
}

scaffold = (phi > 0);

if (enableZnEquation)
{
  if (mpirank==0) { print("Solving Zn concentration equation..."); setCPUTime }

  Loc = zinc(SpaceP1, SpaceP1);
  B = zinc(0, SpaceP1);
  A = Loc;
  Zn[] = A^-1 * B;

  if (mpirank==0) { printElapsedTime }
}

if (enableClEquation)
{
  if (mpirank==0) { print("Solving Cl- concentration equation..."); setCPUTime }

  Loc = chloride(SpaceP1, SpaceP1);
  B = chloride(0, SpaceP1);
  A = Loc;
  Cl[] = A^-1 * B;

  if (mpirank==0) { printElapsedTime }
}

if (enableFilmEquation)
{
  if (mpirank==0) { print("Solving protective-film formation equation..."); setCPUTime }

  Loc = film(SpaceP1, SpaceP1);
  B = film(0, SpaceP1);
  A = Loc;
  F[] = A^-1 * B;

  if (mpirank==0) { printElapsedTime }
}

if (enableO2Equation)
{
  if (mpirank==0) { print("Solving O2 concentration equation (ORR)..."); setCPUTime }

  O2old = O2;

  Loc = oxygen(SpaceP1, SpaceP1);
  B = oxygen(0, SpaceP1);
  A = Loc;
  O2[] = A^-1 * B;

  // Under-relaxation, rescaled so its effective time constant is INDEPENDENT
  // of dt (see config/settings.idp for the derivation). The old code used a
  // hardcoded omega=0.3 every step regardless of dt, which made the O2 lag
  // 4x longer in real time at dt=4h than at dt=1h -- the leading suspect for
  // the 5.03% vs 2.20% mass-loss split between those two timesteps on the
  // same mesh and parameters.
  //
  // Computed per step rather than once up front, so this stays correct when
  // -adaptive_dt varies dt during the run.
  real omega = o2RelaxOmega;
  if (o2RelaxScaleWithDt && o2RelaxRefDt > 0)
    omega = 1.0 - pow(1.0 - o2RelaxOmega, dt / o2RelaxRefDt);
  omega = max(0.0, min(1.0, omega));  // guard against pathological inputs

  if (mpirank==0 && count == 0)
    print("O2 under-relaxation: omegaRef=" + o2RelaxOmega + " at refDt="
          + o2RelaxRefDt + "h  ->  omega=" + omega + " at dt=" + dt + "h");

  O2[] = omega * O2[] + (1.0 - omega) * O2old[];

  if (mpirank==0) { printElapsedTime }
}

if (enableOHEquation)
{
  if (mpirank==0) { print("Solving pH equation..."); setCPUTime }

  Loc = hydroxide(SpaceP1, SpaceP1);
  B = hydroxide(0, SpaceP1);
  A = Loc;
  OH[] = A^-1 * B;

  if (mpirank==0) { printElapsedTime }
}

if (enableFlowSolve)
{
  if (count % flowSolveInterval == 0)
  {
    if (mpirank==0) { print("Solving Navier-Stokes equation..."); setCPUTime }

    NS = navierstokes(SpaceVector, SpaceVector, tgv=-1);
    nsRhs = navierstokes(0, SpaceVector, tgv=-1);

    ux[] = 0;
    ux[] = NS^-1 * nsRhs;

    if (mpirank==0) { printElapsedTime }
  }
}

scaffold = (phi > 0);

ENDIFMACRO//
