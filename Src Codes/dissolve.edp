// CUT-CELL VOLUME (paper_v2): volume of {phi>0} integrated exactly through the cut elements (piecewise-linear phi) instead of the sharp (phi>0)
// count at quadrature points. The sharp count only changes in whole-element steps, so it cannot follow interface motion of 1e-5 mm/h and made the
// reinitialisation volume correction undo real motion (same fix as the frozen A3_cutcell_v1 solver).
macro cutVolume(Th, ph) int3d(Th, levelset=-(ph))(1.) //
// dissolve.edp
// Entry point for Dissolve — a reaction-diffusion + level-set solver for
// degradation of Zn-alloy scaffolds/implants, driven by ORR surface kinetics.
//
// Pipeline: load dependencies -> read settings -> build mesh -> declare
// fields -> assemble governing equations -> solve the Stefan problem for the
// initial interface velocity -> set initial state -> step forward in time.

// 1. Third-party FreeFEM modules and command-line argument parsing
include "config/dependencies.idp"

// 2. Simulation, material, geometry, and solver settings
include "config/settings.idp"

// Flux-first performs one implicit oxygen solve and one recession update per step.
// Multiple Picard passes would repeat the cumulative tallies and move film twice.
if (fluxFirst && vPicard != 0)
{
  if (mpirank == 0) cout << "ERROR_FLUXFIRST_REQUIRES_V_PICARD_0" << endl;
  exit(2);
}
if (fluxFirst && (!enableO2Equation || consMode != 2))
{
  if (mpirank == 0) cout << "ERROR_FLUXFIRST_REQUIRES_O2_AND_CONSERVATIVE_MODE_2" << endl;
  exit(2);
}

if (mpirank == 0)
{
  cout << "DISSOLVE_VERSION v1.1.0" << endl;
  cout << "DISSOLVE_ARGS";
  for (int ia = 0; ia < ARGV.n; ia++) cout << " " << ARGV[ia];
  cout << endl;
}


// 3. Shared macros and helper functions
include "utils/helpers.idp"

// 3b. Disk-space guard for VTK/checkpoint writes (2026-09-08) -- pauses
// before a write if the target filesystem is nearly full, instead of
// silently producing a corrupted 0-byte file and continuing for hours.
// See io/diskspace_guard.idp for the full incident writeup.
include "io/diskspace_guard.idp"

if (mpirank == 0)
{
  printHeader();
  print("Time step (dt): " + dt);
  print("Adaptive dt: " + adaptiveTimeStep + "  (dtMax=" + dtMax + "h, growth=" + dtGrowthFactor + "x, threshold=" + dtStabilityThreshold + "%)");
  print("Output file: " + resultsFilename);

  // Refuse to silently overwrite VTK output from a previous run. -vtk_prefix
  // lets each run point at its own path, but nothing enforced that it actually
  // does -- reusing a path (or forgetting the flag and falling back to the
  // "output/output" default) mid-writes an existing series with no warning.
  // Found worth guarding 2026-08-17 while starting a multi-geometry TPMS
  // porosity study, where each mesh needs its own untouched output folder.
  // -overwrite_vtk 1 bypasses this for deliberate re-runs.
  if (emitVtkOutput && !getARGV("-overwrite_vtk", 0))
  {
    // FreeFEM's parallel savevtk appends "_<mpisize>" to the .pvd filename
    // (confirmed: -np 16 writes output_16.pvd, matching this project's
    // existing convention everywhere else) -- checking bare "name.pvd" here
    // would never find it and the guard would silently never fire.
    string pvdCheck = vtkFilePrefix + "_" + mpisize + ".pvd";
    if (fileExists(pvdCheck))
    {
      print("");
      print("REFUSING TO START: " + pvdCheck + " already exists.");
      print("  -vtk_prefix points at output that's already there -- starting");
      print("  would silently overwrite/interleave with an existing VTK series.");
      print("  Pass a distinct -vtk_prefix, or -overwrite_vtk 1 to proceed anyway.");
      exit(1);
    }
  }
}

// 4. Build and partition the computational domain
include "domain/mesh_setup.idp"

// 5. Declare finite-element spaces and simulation fields
include "state/fields.idp"

// 6. Assemble the weak (variational) forms of the governing PDEs
include "physics/governing_equations.idp"

// 7. Solve for the initial interface velocity (Stefan condition)
include "physics/interface_kinetics.idp"

// 8. Set initial conditions
include "state/initial_state.idp"

// 8b. Override with a checkpoint, if resuming after a crash/freeze instead
//     of a fresh t=0 start (-restart_from <dir>; no-op otherwise)
include "io/checkpoint_read.idp"

// Local matrices/vectors reused across time steps
matrix Loc;
real[int] B(SpaceP1.ndof);
real[int] nsRhs(SpaceVector.ndof);

// Wall-clock start, for the elapsed/ETA display below -- these runs go out
// to 8766h (12 months) of simulated time, so knowing actual real-world
// elapsed time (not just simulated hours) matters for a job that can run
// for days.
real simStartTime = mpiWtime();
real o2InventoryInitial = 0.0;  // liquid-phase oxygen inventory at t=0 for the global balance output

// ---------------------------------------------------------------------------
// Main time-stepping loop
// ---------------------------------------------------------------------------
for (real t = restartT; t < simDuration; t += dt)
{
  // Carry forward the previous step's solution
  phiold = phi;
  Fold   = F;
  Znold  = Zn;
  Clold  = Cl;
  OHold  = OH;
  O2old  = O2;
  if (count) // skip on the very first step
    [upx, upy, upz, pp] = [ux, uy, uz, p];

  // -- Track remaining scaffold volume for this step -------------------
  loc = 0;
  IFMACRO(intN)
    loc = cutVolume(MeshNoOverlap, phi);
  ENDIFMACRO
  IFMACRO(!intN)
    loc = cutVolume(MeshNoOverlap, phi);
  ENDIFMACRO

  glob = 0;
  mpiAllReduce(loc, glob, mpiCommWorld, mpiSUM);
  scaffoldSize = glob;

  if (t == 0)
  {
    initialVolume = scaffoldSize;
    if (mpirank == 0) print("Initial volume (initialVolume): " + initialVolume);
  }

  // paper_v3b: the O2-sink and Zn-source tallies are accumulated at the END of each step (below), before any medium renewal resets the oxygen field.

  if (mpirank == 0)
  {
    real massZnLost = max(0.0, (initialVolume - scaffoldSize) * znDensity);
    real massO2Consumed = massZnLost * 0.2447; // 2 Zn (65.38) : 1 O2 (32.0)

    real pctChange = 0;
    if (initialVolume > 1e-12)
      pctChange = (initialVolume - scaffoldSize) / initialVolume * 100;

    real wallElapsedH = (mpiWtime() - simStartTime) / 3600.0;

    printDivider;
    print("Time: " + t + "h  (" + formatDuration(t) + ")    Step: " + count
    + "    O2 consumed (g): " + massO2Consumed + "    O2sinkCum: " + o2SinkCum + "    ZnSrcCum: " + znSrcCum)
    print("Initial size: " + initialVolume + "    Current size: " + scaffoldSize
    + "    % change: " + pctChange)
    print("Wall-clock elapsed: " + formatDuration(wallElapsedH)
    + "  (" + round2(wallElapsedH) + "h since job start)")
    printDivider;
  }

  if (initialVolume > 1e-12 && ((initialVolume - scaffoldSize) / initialVolume) >= 0.98) // fully degraded
  {
    print("Scaffold is fully degraded - stopping simulation.");
    break;
  }

  // -- I/O for this step -------------------------------------------------
  include "io/write_results.idp"
  include "io/export_geometry.idp"
  include "io/checkpoint_write.idp"

  // -- Advance the interface and field solutions --------------------------
  O2vel = O2;   // pass 0: velocity from the start-of-step oxygen (frozen v4 behaviour)
  thetaVel = theta;   // film coverage seen by the oxygen sink and the velocity
  SpaceP1 phiS = phi, FS = F, ZnS = Zn, ClS = Cl, OHS = OH, O2S = O2, thS = theta;
  for (int pic = 0; pic <= vPicard; pic++)
  {
    if (pic > 0)
    {
      O2vel = vPicardW*O2 + (1.0 - vPicardW)*O2S;   // oxygen at the end of the previous pass
      thetaVel = theta;   // end-of-step coverage of the previous pass
      phi = phiS; F = FS; Zn = ZnS; Cl = ClS; OH = OHS; O2 = O2S; theta = thS;
    }
    if (fluxFirst) { include "physics/flux_first.idp" }
    if (!fluxFirst) { include "physics/interface_velocity.idp" }
    include "numerics/timestep_solver.idp"
    {   // per-pass diagnostics for the semi-implicit coupling: compare the last two passes (only used with -v_picard > 0)
      real aLp = int2d(MeshNoOverlap, levelset=phi)(1.0);
      real sLp = int2d(MeshNoOverlap, levelset=phi)(kORR*sinkRatio*sinkMult*O2);
      real vLp = int2d(MeshNoOverlap, levelset=phi)(-v);
      real tLp = int2d(MeshNoOverlap, levelset=phi)(theta);
      real aGp = 0, sGp = 0, vGp = 0, tGp = 0;
      mpiAllReduce(aLp, aGp, mpiCommWorld, mpiSUM);
      mpiAllReduce(sLp, sGp, mpiCommWorld, mpiSUM);
      mpiAllReduce(vLp, vGp, mpiCommWorld, mpiSUM);
      mpiAllReduce(tLp, tGp, mpiCommWorld, mpiSUM);
      if (mpirank == 0 && vPicard > 0)
        cout << "DEBUG_PICARD t=" << t << " pass=" << pic << " sink=" << sGp << " vmean=" << (vGp/(aGp+1e-30)) << " theta=" << (tGp/(aGp+1e-30)) << endl;
    }
  }
  if (!fluxFirst) {   // paper_v3b: tallies from the end-of-step fields (flux-first tallies on the current interface inside physics/flux_first.idp) (O2, theta, v of the final pass), BEFORE the renewal block can reset O2
    real o2SinkLoc = int2d(MeshNoOverlap, levelset=phi)(kORR*sinkRatio*sinkMult*O2);
    real znSrcLoc  = int2d(MeshNoOverlap, levelset=phi)(znDensity*(-v));
    real o2SinkGlob = 0, znSrcGlob = 0;
    mpiAllReduce(o2SinkLoc, o2SinkGlob, mpiCommWorld, mpiSUM);
    mpiAllReduce(znSrcLoc, znSrcGlob, mpiCommWorld, mpiSUM);
    real auditO2VelPostLoc = int2d(MeshNoOverlap, levelset=phi)(kORR*sinkRatio*sinkMult*O2vel);
    real auditZnExpectedLoc = int2d(MeshNoOverlap, levelset=phi)(znDensity*(-v));
    real auditO2VelPostGlob=0, auditZnExpectedGlob=0;
    mpiAllReduce(auditO2VelPostLoc, auditO2VelPostGlob, mpiCommWorld, mpiSUM);
    mpiAllReduce(auditZnExpectedLoc, auditZnExpectedGlob, mpiCommWorld, mpiSUM);
    if (mpirank == 0)
      cout << "DEBUG_FLUX_POST t=" << t+dt
           << " ZnPerO2Current=" << znSrcGlob/max((2.0*znMolarMass/o2MolarMass)*o2SinkGlob,1e-30)
           << " ZnPerO2VelocityState=" << auditZnExpectedGlob/max((2.0*znMolarMass/o2MolarMass)*auditO2VelPostGlob,1e-30)
           << " O2VelocityStateOverCurrent=" << auditO2VelPostGlob/max(o2SinkGlob,1e-30) << endl;
    o2SinkCum += o2SinkGlob*dt; znSrcCum += znSrcGlob*dt;
  }
  include "numerics/mesh_refinement.idp"

  // optional medium renewal (see -medium_reset_hours)
  if (mediumResetHours > 0.0)
  {
    if (nextResetTime > 1.0e29) nextResetTime = mediumResetHours;
    if (t + dt >= nextResetTime - 1.0e-9)
    {
      real znLoc = 0;
      IFMACRO(intN)
        znLoc = intN(MeshNoOverlap)(Zn * (phi <= 0));
      ENDIFMACRO
      IFMACRO(!intN)
        znLoc = int3d(MeshNoOverlap)(Zn * (phi <= 0));
      ENDIFMACRO
      real znGlob = 0;
      mpiAllReduce(znLoc, znGlob, mpiCommWorld, mpiSUM);
      znRemovedCum += znGlob;
      Zn = Zn * (phi > 0);
      Cl = cl0 * (phi <= 0);
      OH = oh0 * (phi <= 0);
      O2 = o2Initial * (phi <= 0);
      O2old = O2;
      if (mpirank == 0) cout << "MEDIUM_RESET at t=" << (t + dt) << " h  Zn_removed_this_renewal(g)=" << znGlob << "  Zn_removed_cum(g)=" << znRemovedCum << endl;
      nextResetTime += mediumResetHours;
    }
  }

  // ============================================================================
  // ADAPTIVE TIME STEP: grow dt while the step we just took was "quiet"
  // ============================================================================
  // scaffoldSize above is the volume BEFORE this step; compare against the
  // volume AFTER this step's solve to get this step's actual change. Grow dt
  // (never shrink) while that change stays under the stability threshold.
  if (adaptiveTimeStep)
  {
    loc = 0;
    IFMACRO(intN)
      loc = cutVolume(MeshNoOverlap, phi);
    ENDIFMACRO
    IFMACRO(!intN)
      loc = cutVolume(MeshNoOverlap, phi);
    ENDIFMACRO
    glob = 0;
    mpiAllReduce(loc, glob, mpiCommWorld, mpiSUM);
    real scaffoldSizeAfter = glob;

    real stepChangePct = 0;
    if (initialVolume > 1e-12)
      stepChangePct = abs(scaffoldSizeAfter - scaffoldSize) / initialVolume * 100.0;

    if (mpirank == 0)
    {
      if (stepChangePct < dtStabilityThreshold && dt < dtMax)
      {
        real dtOld = dt;
        dt = min(dt * dtGrowthFactor, dtMax);
        print("Adaptive dt: step change " + stepChangePct + "% < threshold " + dtStabilityThreshold + "% -> dt " + dtOld + "h -> " + dt + "h")
      }
      else
      {
        print("Adaptive dt: step change " + stepChangePct + "% -- holding dt at " + dt + "h")
      }
    }
    broadcast(processor(0), dt);
  }

  count += 1;

  mpiBarrier(mpiCommWorld); // keep all ranks in step before the next iteration
}

// Persist the final state of the model
include "io/write_final_state.idp"
