// domain/mesh_setup.idp
// Builds (or imports) the computational domain, initializes the level-set
// field marking the scaffold, and partitions the mesh across MPI ranks.

IFMACRO(!idpMeshSetup)
macro idpMeshSetup 1//

meshN Mesh;
meshN MeshNoOverlap;
meshN MeshBackup;
meshN initialMesh;

if (mpirank == 0)
{
  if (loadMeshFromFile)
  {
    print("Reading input mesh...")



    Mesh = readmesh3(inputMeshPath);
  }
  else
  {
    Mesh = cube(2, 2, 2, [L*x, L*y, L*z]);
    real[int] domain = [0, 0, 0, 0, 1];
    Mesh = tetgreconstruction(Mesh, switch="raAQ", regionlist=domain,
                              sizeofvolume=(L*1./targetMeshSize)^3 / 6);
  }
}

broadcast(processor(0), Mesh);
// MeshBackup MUST be snapshotted here, before buildDmesh() partitions Mesh
// below -- distance() (used during redistancing) is a serial, whole-
// geometry algorithm; it needs a full/replicated mesh, not one rank's
// partition fragment. Confirmed 2026-08-14: moving this after buildDmesh()
// crashes immediately ("Assertion fail: kf >= 0 && kf < neF") because
// MeshBackup became just a partition fragment. The real bug (found via
// per-stage volume instrumentation in numerics/timestep_solver.idp:
// restrict() is volume-exact, but redistancing's final `phi = phiReduce`
// projection from this global MeshBackup back onto the partitioned Mesh
// eats 80-90% of each call's volume loss) is that THAT return trip has no
// index mapping analogous to newToOldGlobal -- not that the snapshot timing is
// wrong. Fix needs a proper reverse map, not a reordering.
MeshBackup = Mesh;
initialMesh = Mesh;

fespace SpaceP1(Mesh, Pk);
fespace SpaceP0(Mesh, P0);
fespace SpaceVector(Mesh, PkVector);

SpaceP1 phi = 0;
SpaceP1 phiTemp;
SpaceP1 mm;

// Analytic-SDF workaround (2026-09-09): for a single thin filament-like
// scaffold (e.g. the controlled-geometry curvature-isolation wires), the
// built-in distance() plugin's far-field output is wrong -- confirmed via
// direct comparison against a lattice run using the identical mesh/box
// setup (FCC p30: far-field phi correctly deep-negative, mean -17.7; the
// wire runs: far-field phi barely negative/sometimes positive, mean
// ~-1.5, wrong even at t=0 before any redistancing). Root cause not fully
// isolated (hypothesis: distance()'s mesh-connectivity-based propagation
// struggles with a sparse, elongated 1D-like interface vs a lattice's
// many strut segments distributed through the domain), but the effect on
// SolidVolume/mass-loss is confirmed real and severe (t=0 SolidVolume
// ~305mm^3 vs the true ~0.26mm^3 for G0_straight_wire). Workaround: when
// -phi_is_distance_field 1 is passed, the loaded .sol is trusted as
// ALREADY a true signed-distance field (computed externally from the
// same analytic SDF used to build the STL, at this exact mesh's node
// positions) and the distance() call below is skipped entirely. Off by
// default -- every other run's .sol convention (raw L2-projected
// indicator, ~[-0.5,0.5]) still needs distance() and is unaffected.
int phiIsAlreadyDistance = getARGV("-phi_is_distance_field", 0);

if (mpirank == 0)
{
  if (loadMeshFromFile)
  {
    string fileName = inputMeshPath + ".sol";

    if (fileExists(fileName))
    {
      phi[] = readsol(fileName);
    }
    else
    {
      print("Detecting mesh regions (vectorized)...")
      meshN MeshScaffold = trunc(Mesh, region==scaffoldRegionTag);

      // Volume-weighted L2 projection of the per-element region indicator
      // onto the continuous P1 space, in place of a direct P1 assignment
      // ("phi = (region==tag)"). A direct assignment is ambiguous at any
      // node shared by solid- and fluid-tagged elements: FreeFEM's nodal
      // write for a discontinuous per-element expression just keeps
      // whichever element it processed last for that node, not a
      // volume-weighted vote. For a thick solid region that never matters
      // (every neighbouring element agrees), but for a strut only 1-2
      // elements wide -- as at high porosity, e.g. BCC p90 -- nearly every
      // node along the strut IS one of these ambiguous boundary nodes, so
      // the arbitrary single-element pick can flip enough interior-strut
      // nodes to falsely pinch the strut in two. Confirmed 2026-09-09:
      // BCC p90's initial phi field showed 165 disconnected solid
      // fragments (largest only 3.75% of solid volume) despite both the
      // source STL and the tagged volume mesh being a single connected
      // piece. The projection below instead solves for the P1 field whose
      // mass-matrix inner product against every test function matches the
      // true per-element indicator -- every node's value becomes a proper
      // volume-weighted average of its neighbouring elements' tags,
      // rather than an arbitrary pick.
      SpaceP0 phi0 = (region == scaffoldRegionTag);

      varf vProjMass(u, v) = int3d(Mesh)(u*v);
      varf vProjRhs(u, v) = int3d(Mesh)(phi0*v);
      matrix projMass = vProjMass(SpaceP1, SpaceP1, solver=CG);
      real[int] projRhs = vProjRhs(0, SpaceP1);
      phi[] = projMass^-1 * projRhs;

      print("")

      phi = phi - 0.5;
      savesol(fileName, Mesh, phi);
    }
  }
  else
  {
    phi = box - 0.5;
  }
}

broadcast(processor(0), phi[]);

if (adaptInitialMesh)
{
  if (mpirank == 0)
  {
    print("Refining mesh...")

    mm = 0.;
    mm[] = mshmet(Mesh, (phi>0),
                  normalization=1, aniso=0, nbregul=1,
                  hmin=meshHMin, hmax=meshHMax, err=mshmetTolerance);

    Mesh = tetgreconstruction(Mesh, switch="raAQ",
                              sizeofvolume=mm*mm*mm/6.);
  }

  broadcast(processor(0), Mesh);
  phi = phi;
}

if (mpirank == 0)
{
  printDivider;
  print("Finite element DOF: " + SpaceP1.ndof);
  print("Number of elements: " + Mesh.nt);

  if (dumpInitialMesh)
  {
    cout << "Saving initial mesh..." << endl;
    savevtk("initialMesh.vtu", Mesh, phi, dataname="phi");
  }
}

if (mpirank == 0 && !phiIsAlreadyDistance)
{
  distance(Mesh, phi, phiTemp[]);
  phi = phiTemp;
}
else if (mpirank == 0)
{
  print("Skipping distance() -- phi loaded as an already-correct analytic signed-distance field.")
}

broadcast(processor(0), phi[]);

if (mpirank == 0)
  print("Partitioning the mesh...")

int[int] newToOldOverlap;
int[int] newToOldGlobal;
NewMacro MeshN2O() newToOldGlobal EndMacro

Mat NS, A;

buildDmesh(Mesh);

{
  macro def(i)[i, i#B, i#C, i#D]//
  macro init(i)[i, i, i, i]//
  createMat(Mesh, NS, PkVector)
}

{
  macro def(i)i//
  macro init(i)i//
  createMat(Mesh, A, Pk)
}

{
  fespace SpaceP0Temp(Mesh, P0);
  SpaceP0Temp part;
  createPartition(Mesh, part[], P0)
  MeshNoOverlap = trunc(Mesh, abs(part - 1.0) < 1e-1, new2old = newToOldOverlap);
}

phi = phi;

if (dumpPartitionedMesh)
{
  savevtk("initialMesh_Partitioned_NoOverlap.vtu", MeshNoOverlap,
          region, dataname="region", append=false);
  savevtk("initialMesh_Partitioned_Overlapped.vtu", Mesh,
          region, dataname="region", append=false);
}

int total = 0;
int currentDofCount = SpaceP1.ndof;
mpiAllReduce(currentDofCount, total, mpiCommWorld, mpiSUM);

if (mpirank == 0)
{
  print("Average DOF per MPI process: " + total / mpisize);
  print("Number of MPI processes: " + mpisize);
}

ENDIFMACRO//
